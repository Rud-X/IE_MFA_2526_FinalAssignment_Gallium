	<relatedMatch xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/xsp/cn2026/283311000080"/>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/qw1/prodcom2026/20134155">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<order xmlns="http://data.europa.eu/qw1/prodcom2026/" rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1740</order>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">20134155</identifier>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Sulphates of barium</altLabel>
	<exactMatch xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/qw1/prodcom2025/20134155"/>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/qw1/prodcom2026/prodcom2026"/>
	<notation xmlns="http://www.w3.org/2004/02/skos/core#">20.13.41.55</notation>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">20.13.41.55 Sulphates of barium</prefLabel>
	<versionInfo xmlns="http://www.w3.org/2002/07/owl#">2021</versionInfo>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/qw1/prodcom2026/201341"/>
	<statUnitMeasure xmlns="http://data.europa.eu/m8g/" rdf:resource="http://data.europa.eu/gzn/su/KG"/>
